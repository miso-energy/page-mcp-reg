              "opengraphImageUrl": "https://opengraph.githubassets.com/2a6aead7defcdee3b3275750a45a76e572e47e0bf91c3acc83518703338dd70e/chroma-core/chroma-mcp",
              "ownerAvatarUrl": "https://avatars.githubusercontent.com/u/105881770?v=4",
              "preferredImage": "https://avatars.githubusercontent.com/u/105881770?v=4",
