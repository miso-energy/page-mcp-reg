              "opengraphImageUrl": "https://opengraph.githubassets.com/c53f36c62cd538a90ac5832a5866472dfd8771b104314150a5aa0eebaf65231f/wix/wix-mcp",
              "ownerAvatarUrl": "https://avatars.githubusercontent.com/u/686511?v=4",
