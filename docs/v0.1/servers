              "opengraphImageUrl": "https://opengraph.githubassets.com/c631e140307ed3b44d7ee45b056627e94a5cf54f6af2f8e7e0f54f4a49cfde89/microsoft/fabric-rti-mcp",
              "ownerAvatarUrl": "https://avatars.githubusercontent.com/u/6154722?v=4",
