              "name": "firmament-mcp",
              "nameWithOwner": "spkenny455/firmament-mcp",
              "opengraphImageUrl": "https://opengraph.githubassets.com/7cb937d4a81809c186a204906e95c89ff62a59231e9cc2e0e1502f0216d52d66/spkenny455/firmament-mcp",
              "ownerAvatarUrl": "https://avatars.githubusercontent.com/u/154342748?u=8d44d54c6a831c85be6e56c562e2e3425bcee8f8&v=4",
              "preferredImage": "https://avatars.githubusercontent.com/u/154342748?u=8d44d54c6a831c85be6e56c562e2e3425bcee8f8&v=4",
              "publicId": "33fd38e2-017e-4c1d-9f20-9d655415b142",
