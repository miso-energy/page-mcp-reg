              "nameWithOwner": "sultanlive/vibeseo-mcp",
              "opengraphImageUrl": "https://opengraph.githubassets.com/89c9ddbe1acf9251495141dbe3e2b35cb9edb76c0a7a6beb9b4c8a919a56c33a/sultanlive/vibeseo-mcp",
              "ownerAvatarUrl": "https://avatars.githubusercontent.com/u/47426878?u=0210c8828f44ffe9c4dd4650cd2e48747473e097&v=4",
              "preferredImage": "https://vibeseo.dev/brand/vibeseo-icon.svg",
              "publicId": "2fdf448d-7c21-4495-a600-3ef1354f6667",
