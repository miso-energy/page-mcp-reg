              "nameWithOwner": "longbridge/longbridge-mcp",
              "opengraphImageUrl": "https://opengraph.githubassets.com/2bec4462a587403c98cc9e7a741482975b44a417167042342b27b1bbae5b5865/longbridge/longbridge-mcp",
              "ownerAvatarUrl": "https://avatars.githubusercontent.com/u/68419756?v=4",
              "preferredImage": "https://avatars.githubusercontent.com/u/68419756?v=4",
              "primaryLanguage": "Rust",
