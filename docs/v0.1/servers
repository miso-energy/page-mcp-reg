              "opengraphImageUrl": "https://opengraph.githubassets.com/56d9e4787e46a358f583ee5993bd20f715353ded0520e3837ca2902857853d22/SkillfulAgents/dialmcp-connector",
              "ownerAvatarUrl": "https://avatars.githubusercontent.com/u/257046075?v=4",
              "preferredImage": "https://raw.githubusercontent.com/SkillfulAgents/dialmcp-connector/main/assets/logo.png",
