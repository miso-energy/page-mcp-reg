              "nameWithOwner": "macfax/macfax-mcp",
              "opengraphImageUrl": "https://opengraph.githubassets.com/13ae265b11daf9738bbb6db425c4c4e387e8d0e612360af41c9cda61e3ba00fe/macfax/macfax-mcp",
              "ownerAvatarUrl": "https://avatars.githubusercontent.com/u/282717355?u=7681a80f1887122abe739d99aee2e9c9c2543296&v=4",
              "preferredImage": "https://avatars.githubusercontent.com/u/282717355?u=7681a80f1887122abe739d99aee2e9c9c2543296&v=4",
              "primaryLanguage": "JavaScript",
