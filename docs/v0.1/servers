              "opengraphImageUrl": "https://opengraph.githubassets.com/1565e71a1969b5a860c376b912bd9091602f45d1fa6a65ba929cc735793e5a5c/tallyfy/mcp-public",
              "ownerAvatarUrl": "https://avatars.githubusercontent.com/u/17618822?v=4",
