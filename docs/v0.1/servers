              "opengraphImageUrl": "https://opengraph.githubassets.com/c30f458223638535cb6337c76c89ecf385127c4d618785a51878b20c77bbe78f/chroma-core/chroma-mcp",
              "ownerAvatarUrl": "https://avatars.githubusercontent.com/u/105881770?v=4",
