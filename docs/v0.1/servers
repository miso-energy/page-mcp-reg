              "opengraphImageUrl": "https://opengraph.githubassets.com/f3e67175f95a13b82d50139320e9e41226df031e4a40201718285665adfa8fab/oakallow/oakallow-mcp",
              "ownerAvatarUrl": "https://avatars.githubusercontent.com/u/278273466?v=4",
              "preferredImage": "https://avatars.githubusercontent.com/u/278273466?v=4",
