              "opengraphImageUrl": "https://opengraph.githubassets.com/a8c740570a66401665ee758c92bfe7f8c97b5dd2e3af7ec914772da16b0a2832/SAP/open-ux-tools",
              "ownerAvatarUrl": "https://avatars.githubusercontent.com/u/2531208?v=4",
