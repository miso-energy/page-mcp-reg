              "nameWithOwner": "CrowdStrike/falcon-mcp",
              "opengraphImageUrl": "https://opengraph.githubassets.com/e87b8ee739bb2bc7eb50b7a598df2242d8b99755112ae252ee163b744f1e0f42/CrowdStrike/falcon-mcp",
              "ownerAvatarUrl": "https://avatars.githubusercontent.com/u/2446477?v=4",
              "preferredImage": "https://avatars.githubusercontent.com/u/2446477?v=4",
              "primaryLanguage": "Python",
              "primaryLanguageColor": "#3572A5",
              "publicId": "69fdddec-c3c8-4fab-b93a-5f8741b31ec5",
