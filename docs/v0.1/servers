              "opengraphImageUrl": "https://opengraph.githubassets.com/6a6ba2f0331e224f161c933f9346c79486d199470573f61053d39802ba93f6de/amplitude/mcp-server-guide",
              "ownerAvatarUrl": "https://avatars.githubusercontent.com/u/2291562?v=4",
